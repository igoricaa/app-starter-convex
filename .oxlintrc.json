{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react", "import"],
  "jsPlugins": ["@shadcn/lint"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["convex/_generated/**", "src/routeTree.gen.ts", ".agents/**", ".claude/**"],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/_generated/server"],
            "importNames": [
              "query",
              "mutation",
              "action",
              "internalQuery",
              "internalMutation",
              "internalAction"
            ],
            "message": "Build functions with the wrappers in convex/functions.ts."
          }
        ]
      }
    ],
    "shadcn/no-restyle": [
      "error",
      {
        "allow": ["layout"]
      }
    ],
    "shadcn/no-raw-colors": "error",
    "shadcn/no-arbitrary-values": "error",
    "shadcn/no-inline-styles": "error",
    "shadcn/no-unknown-classes": "error",
    "shadcn/require-static-classes": "error"
  },
  "overrides": [
    {
      "files": ["convex/functions.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["src/components/ui/**"],
      "rules": {
        "shadcn/no-restyle": "off",
        "shadcn/no-arbitrary-values": "off"
      }
    }
  ]
}
